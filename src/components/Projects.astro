---
import { FaPython, FaJava, FaGithub } from 'react-icons/fa';
import { SiDjango, SiSelenium, SiJavascript, SiNodedotjs, SiPostgresql } from 'react-icons/si';
import { getImage } from 'astro:assets';
import ProjectGallery from './ProjectGallery.astro';

const getOptimizedImages = async (globMap: any) => {
  const entries = Object.entries(globMap).sort(([a], [b]) => a.localeCompare(b, 'es'));
  const optimized = await Promise.all(entries.map(async ([, image]) => {
    if (typeof image === 'string') {
      return image;
    }
    // Optimizar imagen para mejor nitidez en el visualizador
    const optImg = await getImage({ src: image as any, width: 1600, format: 'webp', quality: 95 });
    return optImg.src;
  }));
  return optimized.filter(Boolean);
};

const equigrafoImages = await getOptimizedImages(
  import.meta.glob('../assets/projects/equigrafo/*.{png,jpg,jpeg,webp,gif,svg}', { eager: true, import: 'default' })
);

const sportplusImages = await getOptimizedImages(
  import.meta.glob('../assets/projects/sportplus/*.{png,jpg,jpeg,webp,gif,svg}', { eager: true, import: 'default' })
);

const galleries = {
  aguadulce: [
    ...Object.values(import.meta.glob('../assets/projects/aguadulce/*.mp4', { eager: true, query: '?url', import: 'default' })),
    ...await getOptimizedImages(import.meta.glob('../assets/projects/aguadulce/*.{png,jpg,jpeg,webp}', { eager: true, import: 'default' })),
  ],
  equigrafo: equigrafoImages,
  sportplus: sportplusImages,
};

---

<section class="projects-section container mx-auto px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
  <h2 class="mb-4 text-3xl font-semibold text-pink-500 md:text-4xl"><span class="lang-es">Proyectos</span><span class="lang-en">Projects</span></h2>
  <div class="w-full sm:w-3/4 md:w-[60%] mt-4 mb-8">
    <p class="project-paragraph relative group text-lg text-slate-700 dark:text-slate-300 sm:text-xl leading-relaxed transition-colors duration-300">
      <span class="lang-es">Un vistazo a lo que he <span class="text-pink-500 dark:text-[#ffde59]">construido</span>.</span>
      <span class="lang-en">A glimpse of what I've <span class="text-pink-500 dark:text-[#ffde59]">built</span>.</span>
      <span class="flash-overlay absolute inset-0 rounded-lg bg-pink-500 opacity-0 blur-lg transition duration-500 group-hover:opacity-20"></span>
    </p>
  </div>

  <div class="grid items-start gap-4 sm:gap-6 lg:grid-cols-2">
    <article
      class="card group flex flex-col w-full cursor-pointer rounded-lg border border-[#b9d5c0] dark:border-[#a8cfb0]/25 bg-[#e5f0e7] dark:bg-[#24382d] p-0 text-left shadow-lg opacity-0 transition-all duration-300 hover:-translate-y-2 hover:scale-[1.015] hover:border-[#83ad8e] dark:hover:border-[#b8dfc0]/60 hover:shadow-[0_18px_40px_rgba(168,207,176,0.12)] focus:outline-none focus:ring-2 focus:ring-[#a8cfb0]/70"
      data-open-gallery="aguadulce" tabindex="0"
    >
      <div class="flex flex-col p-4 transition-transform duration-300 sm:p-5 group-hover:scale-[1.01]">
        <video data-project-cover src="/assets/aguadulcevideo.mp4" poster="/assets/aguadulce.png" muted loop playsinline preload="metadata" aria-label="Vista previa de Aguadulce"
          class="mb-3 h-40 w-full rounded-md object-cover transition duration-300 sm:h-48 lg:h-52 group-hover:brightness-110 group-hover:shadow-[0_12px_30px_rgba(168,207,176,0.15)]" />
        <div class="mb-2 flex items-start justify-between gap-3 sm:gap-4">
          <h3 class="text-lg font-semibold text-[#2f513c] dark:text-[#d3ebd8] sm:text-xl lg:text-2xl transition-colors duration-300">Aguadulce</h3>
          <span class="shrink-0 rounded-full border border-[#83ad8e]/40 bg-[#cfe3d3] dark:bg-[#a8cfb0]/10 px-2 py-1 text-xs text-[#365d43] dark:text-[#c4e3cc]">
            {galleries.aguadulce.length - 1} <span class="lang-es">fotos y 1 video</span><span class="lang-en">photos and 1 video</span>
          </span>
        </div>
        <p class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs sm:text-sm min-h-[28px]">
          <span class="inline-flex items-center gap-1.5 text-yellow-700 dark:text-[#ffde59]"><SiJavascript size={20} />JavaScript</span>
          <span class="inline-flex items-center gap-1.5 text-[#365d43] dark:text-[#b8dfc0]"><SiNodedotjs size={20} />Node.js</span>
          <span class="inline-flex items-center gap-1.5 text-sky-700 dark:text-sky-200"><SiPostgresql size={20} />PostgreSQL</span>
        </p>
        <div class="mt-auto text-xs leading-relaxed text-slate-600 dark:text-slate-200 sm:text-sm relative z-10 min-h-[3.5rem]" onclick="event.stopPropagation()">
          <input type="checkbox" id="toggle-aguadulce" class="peer hidden" />
          <span class="cursor-text"><span class="lang-es">Plataforma de gestión para restaurantes con carta digital y pedidos por mesa</span><span class="lang-en">Restaurant management platform with a digital menu and table ordering</span></span><label for="toggle-aguadulce" class="peer-checked:hidden cursor-pointer text-[#365d43] dark:text-[#b8dfc0] hover:underline font-semibold px-2 py-1 select-none"><span class="lang-es">... ver más</span><span class="lang-en">... see more</span></label><span class="hidden peer-checked:inline cursor-text"><span class="lang-es">. Integra módulos de meseros, cocina y caja, junto con control de inventario y administración de usuarios por roles, para organizar la operación del restaurante desde una sola plataforma.<br class="mt-1"><strong class="font-bold dark:font-semibold text-[#365d43] dark:text-[#d3ebd8]">Tecnologías:</strong></span><span class="lang-en">. Combines waiter, kitchen and cashier modules with inventory tracking and role-based user management to organize restaurant operations in one platform.<br class="mt-1"><strong class="font-bold dark:font-semibold text-[#365d43] dark:text-[#d3ebd8]">Technologies:</strong></span> JavaScript, Vite, Tailwind CSS, Node.js, Express, Prisma, PostgreSQL, Supabase.</span><label for="toggle-aguadulce" class="hidden peer-checked:inline-flex cursor-pointer text-[#365d43] dark:text-[#b8dfc0] hover:underline font-semibold px-2 py-1 select-none"><span class="lang-es">(ocultar)</span><span class="lang-en">(hide)</span></label>
        </div>
      </div>
    </article>
    <article
      class="card group flex flex-col w-full cursor-pointer rounded-lg border border-slate-300 dark:border-gray-600 bg-white dark:bg-white/20 p-0 text-left shadow-lg opacity-0 transition-all duration-300 hover:-translate-y-2 hover:scale-[1.015] hover:border-pink-400 dark:hover:border-pink-300/50 hover:shadow-[0_18px_40px_rgba(236,72,153,0.15)] focus:outline-none focus:ring-2 focus:ring-pink-400/70"
      data-open-gallery="equigrafo"
      tabindex="0"
    >
      <div class="flex flex-col p-4 transition-transform duration-300 sm:p-5 group-hover:scale-[1.01]">
        <img
          src="/assets/equigrafo.png"
          alt="Equigrafo"
          class="mb-3 h-40 w-full rounded-md object-cover transition duration-300 sm:h-48 lg:h-52 group-hover:brightness-110 group-hover:shadow-[0_12px_30px_rgba(236,72,153,0.2)] dark:group-hover:shadow-[0_12px_30px_rgba(0,0,0,0.35)]"
        />
        <div class="mb-2 flex items-start justify-between gap-3 sm:gap-4">
          <h3 class="text-lg font-semibold text-slate-800 dark:text-white sm:text-xl lg:text-2xl transition-colors duration-300">Equigrafo</h3>
          <span class="shrink-0 rounded-full border border-pink-400/40 bg-pink-100 dark:bg-pink-500/10 px-2 py-1 text-xs text-pink-600 dark:text-pink-200 transition-colors duration-300">
            {galleries.equigrafo.length} <span class="lang-es">fotos</span><span class="lang-en">photos</span>
          </span>
        </div>
        <p class="mb-3 flex flex-wrap items-center text-xs sm:text-sm min-h-[28px]">
          <FaPython size={20} className="mr-1.5 text-yellow-500 dark:text-[#ffde59] transition-transform transform hover:scale-110 hover:shadow-python" />
          <span class="text-yellow-600 dark:text-[#ffde59] text-shadow-python font-medium dark:font-normal">Python</span>
          <SiDjango size={20} className="mx-1.5 text-green-500 dark:text-[#c1ff72] transition-transform transform hover:scale-110 hover:shadow-django" />
          <span class="text-green-600 dark:text-[#c1ff72] text-shadow-django font-medium dark:font-normal">Django</span>
          <SiSelenium size={20} className="mx-1.5 text-slate-700 dark:text-white transition-transform transform hover:scale-110 hover:shadow-selenium" />
          <span class="text-slate-700 dark:text-white text-shadow-selenium font-medium dark:font-normal">Selenium</span>
        </p>
        
        <div class="mt-auto text-xs leading-relaxed text-slate-600 dark:text-slate-200 sm:text-sm relative z-10 min-h-[3.5rem] transition-colors duration-300" onclick="event.stopPropagation()">
          <input type="checkbox" id="toggle-equigrafo" class="peer hidden" />
          <span class="cursor-text lang-es">Plataforma integral para una tienda de cámaras con vista optimizada de productos</span><span class="cursor-text lang-en">Comprehensive platform for a camera store with optimized product view</span><label for="toggle-equigrafo" class="peer-checked:hidden cursor-pointer text-pink-500 dark:text-pink-400 hover:text-pink-400 dark:hover:text-pink-300 font-semibold dark:font-medium px-2 py-1 select-none transition-colors"><span class="lang-es">... ver más</span><span class="lang-en">... see more</span></label><span class="hidden peer-checked:inline cursor-text"><span class="lang-es">. Implementa gestión avanzada de inventarios, control de permisos mediante roles y un panel administrativo completo. Incluye un módulo de analíticas en tiempo real para estadísticas de flujo de ingresos, así como generación automática de facturas en PDF para clientes.<br class="mt-1"><strong class="font-bold dark:font-semibold text-pink-600 dark:text-pink-100">Tecnologías:</strong></span><span class="lang-en">. Implements advanced inventory management, role-based permission control, and a complete administrative panel. Includes a real-time analytics module for revenue stream statistics, as well as automatic PDF invoice generation for customers.<br class="mt-1"><strong class="font-bold dark:font-semibold text-pink-600 dark:text-pink-100">Technologies:</strong></span> Python, Django, Selenium, Bootstrap, MySQL, HTML, CSS, JavaScript.</span><label for="toggle-equigrafo" class="hidden peer-checked:inline-flex cursor-pointer text-pink-500 dark:text-pink-400 hover:text-pink-400 dark:hover:text-pink-300 font-semibold dark:font-medium px-2 py-1 select-none transition-colors"><span class="lang-es">(ocultar)</span><span class="lang-en">(hide)</span></label>
        </div>

      </div>
    </article>

    <article
      class="card group flex flex-col w-full cursor-pointer rounded-lg border border-slate-300 dark:border-gray-600 bg-cyan-50 dark:bg-[#0097b2]/30 p-0 text-left shadow-lg opacity-0 transition-all duration-300 hover:-translate-y-2 hover:scale-[1.015] hover:border-cyan-400 dark:hover:border-cyan-200/50 hover:shadow-[0_18px_40px_rgba(34,211,238,0.15)] focus:outline-none focus:ring-2 focus:ring-cyan-300/70"
      data-open-gallery="sportplus"
      tabindex="0"
    >
      <div class="flex flex-col p-4 transition-transform duration-300 sm:p-5 group-hover:scale-[1.01]">
        <img
          src="/assets/sportplus.png"
          alt="SportPlus"
          class="mb-3 h-40 w-full rounded-md object-cover transition duration-300 sm:h-48 lg:h-52 group-hover:brightness-110 group-hover:shadow-[0_12px_30px_rgba(34,211,238,0.2)] dark:group-hover:shadow-[0_12px_30px_rgba(0,0,0,0.35)]"
        />
        <div class="mb-2 flex items-start justify-between gap-3 sm:gap-4">
          <h3 class="text-lg font-semibold text-slate-800 dark:text-white sm:text-xl lg:text-2xl transition-colors duration-300">SportPlus</h3>
          <span class="shrink-0 rounded-full border border-cyan-300/40 bg-cyan-100 dark:bg-cyan-500/10 px-2 py-1 text-xs text-cyan-700 dark:text-cyan-100 transition-colors duration-300">
            {galleries.sportplus.length} <span class="lang-es">fotos</span><span class="lang-en">photos</span>
          </span>
        </div>
        <p class="mb-3 flex items-center text-xs sm:text-sm min-h-[28px]">
          <FaJava size={20} className="mr-1.5 text-red-500 transition-transform transform hover:scale-110 hover:shadow-java" />
          <span class="text-red-600 dark:text-red-500 text-shadow-java font-medium dark:font-normal">Java</span>
        </p>
        
        <div class="mt-auto text-xs leading-relaxed text-slate-700 dark:text-white sm:text-sm relative z-10 min-h-[3.5rem] transition-colors duration-300" onclick="event.stopPropagation()">
          <input type="checkbox" id="toggle-sportplus" class="peer hidden" />
          <span class="cursor-text"><span class="lang-es">Sistema Punto de Venta (POS) para locales deportivos</span><span class="lang-en">Point of Sale (POS) system for sports stores</span></span><label for="toggle-sportplus" class="peer-checked:hidden cursor-pointer text-cyan-600 dark:text-cyan-300 hover:text-cyan-500 dark:hover:text-cyan-200 font-semibold dark:font-medium px-2 py-1 select-none transition-colors"><span class="lang-es">... ver más</span><span class="lang-en">... see more</span></label><span class="hidden peer-checked:inline cursor-text"><span class="lang-es">. Proporciona automatización de inventarios, alertas de falta de stock y un panel de facturación rápido. Cuenta con un robusto CRUD para gestión de empleados, sucursales y proveedores. Además, permite visualizar estadísticas de ingresos y crear reportes dinámicos. Orientado en optimizar la productividad del empleado con una interfaz intuitiva de escritorio.<br class="mt-1"><strong class="font-bold dark:font-semibold text-cyan-700 dark:text-cyan-100">Tecnologías:</strong> Java, Java Swing (UI), MySQL, JDBC.</span><span class="lang-en">. Provides inventory automation, low-stock alerts, and a fast billing panel. Features a robust CRUD for managing employees, branches, and suppliers. Additionally, it allows visualization of revenue statistics and dynamic report generation. Focused on optimizing employee productivity through an intuitive desktop interface.<br class="mt-1"><strong class="font-bold dark:font-semibold text-cyan-700 dark:text-cyan-100">Technologies:</strong> Java, Java Swing (UI), MySQL, JDBC.</span></span><label for="toggle-sportplus" class="hidden peer-checked:inline-flex cursor-pointer text-cyan-600 dark:text-cyan-300 hover:text-cyan-500 dark:hover:text-cyan-200 font-semibold dark:font-medium px-2 py-1 select-none transition-colors"><span class="lang-es">(ocultar)</span><span class="lang-en">(hide)</span></label>
        </div>

      </div>
    </article>
  </div>
</section>

<ProjectGallery galleries={galleries} />

<style>
  .flash-active .flash-overlay {
    animation: aboutFlash 1.8s ease-out;
  }

  @keyframes aboutFlash {
    0% {
      opacity: 0;
      transform: scale(0.98);
    }
    30% {
      opacity: 0.24;
      transform: scale(1.02);
    }
    100% {
      opacity: 0;
      transform: scale(1);
    }
  }

  .shadow-lg {
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1), 0 2px 4px rgba(0, 0, 0, 0.06);
  }

  .hover\:shadow-python:hover {
    filter: drop-shadow(0 0 10px rgba(255, 222, 89, 0.6));
  }
  .hover\:shadow-django:hover {
    filter: drop-shadow(0 0 10px rgba(193, 255, 114, 0.6));
  }
  .hover\:shadow-selenium:hover {
    filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.6));
  }
  .hover\:shadow-java:hover {
    filter: drop-shadow(0 0 10px rgba(255, 0, 0, 0.6));
  }

  .text-shadow-python {
    text-shadow: 0 0 10px rgba(255, 222, 89, 0.6);
  }
  .text-shadow-django {
    text-shadow: 0 0 10px rgba(193, 255, 114, 0.6);
  }
  .text-shadow-selenium {
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.6);
  }
  .text-shadow-java {
    text-shadow: 0 0 10px rgba(255, 0, 0, 0.6);
  }

  @keyframes fadeInUp {
    0% {
      opacity: 0;
      transform: translateY(30px) scale(0.95);
    }
    60% {
      opacity: 1;
      transform: translateY(-10px) scale(1.02);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  .animate-fadeInUp {
    animation: fadeInUp 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-fadeInUp {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  .no-scrollbar {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }

  :global(html) {
    scrollbar-gutter: stable;
  }
</style>

<script type="module" is:inline define:vars={{ galleries }}>
  const cards = document.querySelectorAll('[data-open-gallery]');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-fadeInUp');
          observer.unobserve(entry.target);
        }
      });
    },
    {
      threshold: 0.18,
      rootMargin: '0px 0px -18% 0px',
    }
  );

  cards.forEach((card) => observer.observe(card));

  const projectsSection = document.querySelector('.projects-section');
  const projectParagraphs = document.querySelectorAll('.project-paragraph');
  
  const playProjectSequence = () => {
    projectParagraphs.forEach((paragraph, index) => {
      paragraph.classList.remove('flash-active');
      window.setTimeout(() => {
        paragraph.classList.add('flash-active');
        window.setTimeout(() => {
          paragraph.classList.remove('flash-active');
        }, 1800);
      }, index * 520);
    });
  };

  const projectObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          playProjectSequence();
          projectObserver.unobserve(entry.target);
        }
      });
    },
    {
      threshold: 0.25,
      rootMargin: '0px 0px -12% 0px',
    }
  );

  if (projectsSection) {
    projectObserver.observe(projectsSection);
  }
</script>
