---
import { FaGithub } from 'react-icons/fa';
const { galleries } = Astro.props;
---

<div id="project-gallery-modal" class="project-viewer" role="dialog" aria-modal="true" aria-labelledby="viewer-title" hidden>
  <div class="viewer-backdrop" data-close></div>
  <div class="viewer-window">
    <header>
      <div class="window-controls">
        <button class="window-dot close" data-close aria-label="Cerrar / Close"><span>×</span></button>
        <span class="window-dot yellow" aria-hidden="true"></span>
        <span class="window-dot green" aria-hidden="true"></span>
      </div>
      <h3 id="viewer-title"></h3>
      <div class="window-links">
        <a id="viewer-site" target="_blank" rel="noopener noreferrer"><span class="lang-es">Ver sitio</span><span class="lang-en">Visit site</span> ↗</a>
        <a id="viewer-repo" target="_blank" rel="noopener noreferrer"><FaGithub size={17}/><span class="lang-es">Código</span><span class="lang-en">Code</span></a>
      </div>
    </header>
    <div id="viewer-carousel" class="viewer-carousel" tabindex="0" aria-label="Galería: arrastra para explorar / Gallery: drag to explore">
      <div id="viewer-track" class="viewer-track"></div>
    </div>
    <footer>
      <span><span class="lang-es">Arrastra para explorar · Toca una foto para ampliarla</span><span class="lang-en">Drag to explore · Tap a photo to enlarge</span></span>
      <button id="viewer-motion" aria-pressed="false"><span class="lang-es">Pausar movimiento</span><span class="lang-en">Pause motion</span></button>
    </footer>
    <div id="viewer-detail" class="viewer-detail" hidden>
      <button id="viewer-detail-close" aria-label="Volver al carrusel / Back to carousel">×</button>
      <div id="viewer-detail-viewport" class="detail-viewport"><img id="viewer-detail-image" alt=""/></div>
    </div>
  </div>
</div>

<style>
  .project-viewer[hidden], .viewer-detail[hidden] { display:none; }
  .project-viewer { position:fixed; inset:0; z-index:100; display:grid; place-items:center; padding:24px; color:#e8eeeb; }
  .viewer-backdrop { position:absolute; inset:0; background:#050a08dc; backdrop-filter:blur(16px); }
  .viewer-window { --accent:#b8dfc0; --surface:#24382d; position:relative; display:flex; flex-direction:column; width:min(1600px,100%); height:min(900px,calc(100dvh - 48px)); background:var(--surface); border:1px solid color-mix(in srgb,var(--accent) 28%,transparent); border-radius:18px; overflow:hidden; box-shadow:0 35px 120px #0009,0 0 45px color-mix(in srgb,var(--accent) 10%,transparent); }
  header { display:flex; align-items:center; justify-content:space-between; gap:16px; padding:16px 20px; border-bottom:1px solid #ffffff0d; }
  .window-controls { display:flex; gap:8px; min-width:62px; }
  .window-dot { display:grid; place-items:center; width:14px; height:14px; border-radius:50%; border:1px solid #0002; }
  .close { background:#ff5f56; cursor:pointer; color:#5a1412; font-size:13px; }
  .close span { opacity:0; } .close:hover span,.close:focus-visible span { opacity:1; }
  .yellow { background:#ffbd2e; } .green { background:#27c93f; }
  .close { box-shadow:0 0 9px #ff5f5660; transition:box-shadow .2s,filter .2s; }
  .close:hover,.close:focus-visible { box-shadow:0 0 18px #ff5f56aa; filter:brightness(1.15); }
  .yellow { box-shadow:0 0 9px #ffbd2e50; } .green { box-shadow:0 0 9px #27c93f50; }
  h3 { font-family:monospace; font-size:13px; color:#a9b5ae; letter-spacing:.04em; }
  .window-links { display:flex; gap:8px; }
  a,footer button { display:inline-flex; align-items:center; justify-content:center; gap:7px; padding:8px 11px; border:1px solid #ffffff1a; border-radius:9px; font-size:12px; background:#ffffff05; cursor:pointer; transition:background .2s; }
  a,footer button { color:var(--accent); border-color:color-mix(in srgb,var(--accent) 30%,transparent); background:color-mix(in srgb,var(--accent) 7%,transparent); box-shadow:0 0 12px color-mix(in srgb,var(--accent) 12%,transparent); transition:background .2s,box-shadow .2s,border-color .2s; }
  a:hover,footer button:hover,a:focus-visible,footer button:focus-visible { background:color-mix(in srgb,var(--accent) 15%,transparent); border-color:var(--accent); box-shadow:0 0 22px color-mix(in srgb,var(--accent) 32%,transparent); }
  h3 { color:color-mix(in srgb,var(--accent) 75%,white); }
  header,footer { border-color:color-mix(in srgb,var(--accent) 12%,transparent); }
  .viewer-carousel { flex:1; min-height:0; overflow:hidden; display:flex; align-items:center; cursor:grab; touch-action:pan-y; user-select:none; }
  .viewer-carousel.dragging { cursor:grabbing; }
  .viewer-track { display:flex; align-items:center; gap:24px; height:100%; width:max-content; will-change:transform; padding:28px 0; }
  .viewer-track :global(.viewer-slide) { flex:none; width:min(76vw,1100px); height:100%; display:flex; flex-direction:column; justify-content:center; gap:12px; }
  .viewer-track :global(img), .viewer-track :global(video) { width:100%; min-height:0; max-height:calc(100% - 30px); aspect-ratio:16/10; object-fit:contain; border-radius:12px; background:#0b100e; box-shadow:0 15px 45px #0004; }
  .viewer-track :global(img) { cursor:zoom-in; }
  .viewer-track :global(figcaption) { color:#89988f; font:11px monospace; letter-spacing:.06em; }
  footer { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:12px 20px 16px; font-size:11px; color:#9caaa1; border-top:1px solid #ffffff0d; }
  .viewer-detail { position:absolute; inset:55px 0 0; z-index:5; overflow:hidden; background:#0b100efa; padding:48px 24px 24px; }
  .detail-viewport { height:100%; width:100%; overflow:auto; display:flex; align-items:center; justify-content:center; }
  .viewer-detail img { width:100%; height:100%; object-fit:contain; border-radius:8px; cursor:zoom-in; transform-origin:center; }
  .detail-viewport.zoomed { display:block; }
  .detail-viewport.zoomed img { width:200%; max-width:none; height:auto; cursor:zoom-out; }
  .viewer-detail button { position:fixed; right:46px; top:95px; z-index:6; width:36px; height:36px; background:#28362eee; border:1px solid #ffffff30; border-radius:50%; font-size:24px; cursor:pointer; }
  .viewer-detail { background:color-mix(in srgb,var(--surface) 90%,#050806); }
  .viewer-detail button { color:var(--accent); background:var(--surface); border-color:color-mix(in srgb,var(--accent) 40%,transparent); box-shadow:0 0 14px color-mix(in srgb,var(--accent) 20%,transparent); transition:box-shadow .2s,border-color .2s; }
  .viewer-detail button:hover,.viewer-detail button:focus-visible { border-color:var(--accent); box-shadow:0 0 24px color-mix(in srgb,var(--accent) 45%,transparent); }
  button:focus-visible,a:focus-visible,.viewer-carousel:focus-visible { outline:2px solid var(--accent); outline-offset:3px; }
  @media(max-width:640px) { .project-viewer { padding:0; } .viewer-window { height:100dvh; border-radius:0; border:0; } header { padding:14px 12px; gap:8px; flex-wrap:wrap; } h3 { font-size:11px; } .window-links { gap:5px; } a { padding:7px; font-size:11px; } .viewer-track { gap:14px; padding:20px 0; } .viewer-track :global(.viewer-slide) { width:88vw; } footer { padding:12px 12px max(16px,env(safe-area-inset-bottom)); font-size:10px; } footer button { font-size:10px; flex-shrink:0; } .viewer-detail { padding:44px 10px 16px; } .viewer-detail button { top:80px; right:12px; } }
</style>

<script is:inline type="module" define:vars={{ galleries }}>
  const modal = document.getElementById('project-gallery-modal');
  document.body.append(modal);
  const carousel = document.getElementById('viewer-carousel');
  const track = document.getElementById('viewer-track');
  const detail = document.getElementById('viewer-detail');
  const detailImage = document.getElementById('viewer-detail-image');
  const detailViewport = document.getElementById('viewer-detail-viewport');
  const motion = document.getElementById('viewer-motion');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const meta = {
    aguadulce: { title:'Aguadulce', repo:'https://github.com/Matheuzkml/Restaurant', site:'https://aguadulce-7j4j.onrender.com/', accent:'#b8dfc0', surface:'#24382d' },
    equigrafo: { title:'Equigrafo', repo:'https://github.com/Matheuzk/Equigrafo', accent:'#f9a8d4', surface:'#30272e' },
    sportplus: { title:'SportPlus', repo:'https://github.com/Matheuzk/SportPlus', accent:'#67e8f9', surface:'#183b43' },
  };
  let position=0, cycle=0, frame=0, lastTime=0, paused=false, dragging=false, dragX=0, travel=0, resumeAt=0, returnFocus;
  const videos = () => track.querySelectorAll('video');
  const covers = document.querySelectorAll('[data-project-cover]');
  const updateMotion = () => {
    motion.setAttribute('aria-pressed', String(paused));
    motion.innerHTML = paused ? '<span class="lang-es">Reanudar movimiento</span><span class="lang-en">Resume motion</span>' : '<span class="lang-es">Pausar movimiento</span><span class="lang-en">Pause motion</span>';
  };
  const render = () => {
    if (!cycle) return;
    // Three identical sets keep the seam outside the viewport in both directions.
    position = ((position - cycle) % cycle + cycle) % cycle + cycle;
    track.style.transform = `translate3d(${-position}px,0,0)`;
  };
  const measure = () => {
    const slides=track.children, count=slides.length/3;
    if (!count) return;
    const oldCycle=cycle;
    cycle=slides[count].offsetLeft-slides[0].offsetLeft;
    position=oldCycle ? position/oldCycle*cycle : cycle;
    render();
  };
  const animate = time => {
    const elapsed=lastTime ? Math.min(time-lastTime,50) : 0;
    lastTime=time;
    if (!paused && !dragging && detail.hidden && time>resumeAt && !document.hidden) {
      position += elapsed * .065;
      render();
    }
    const bounds=carousel.getBoundingClientRect();
    videos().forEach(video => {
      const rect=video.getBoundingClientRect();
      const visible=rect.right>bounds.left && rect.left<bounds.right;
      if (visible && detail.hidden && !document.hidden) { if(video.paused && !video.dataset.userPaused) video.play().catch(()=>{}); }
      else if(!video.paused) { video.dataset.autoPaused='true'; video.pause(); }
    });
    frame=requestAnimationFrame(animate);
  };
  let detailAnimation, detailSource;
  const resetDetailZoom = () => {
    detailViewport.classList.remove('zoomed');
    detailViewport.scrollTo(0,0);
  };
  const toggleDetailZoom = event => {
    if(detailViewport.classList.contains('zoomed')) {
      resetDetailZoom();
      return;
    }
    // Account for the empty margins produced by object-fit: contain.
    const bounds=detailImage.getBoundingClientRect();
    const ratio=detailImage.naturalWidth/detailImage.naturalHeight;
    const width=Math.min(bounds.width,bounds.height*ratio);
    const height=width/ratio;
    const left=bounds.left+(bounds.width-width)/2;
    const top=bounds.top+(bounds.height-height)/2;
    if(event.clientX<left||event.clientX>left+width||event.clientY<top||event.clientY>top+height) return;
    const x=(event.clientX-left)/width;
    const y=(event.clientY-top)/height;
    detailViewport.classList.add('zoomed');
    detailViewport.scrollTo({
      left:x*detailImage.offsetWidth-detailViewport.clientWidth/2,
      top:y*detailImage.offsetHeight-detailViewport.clientHeight/2,
      behavior:'instant',
    });
  };
  detailImage.addEventListener('click',toggleDetailZoom);
  const openDetail = element => {
    detailAnimation?.cancel();
    detailSource=element;
    detailImage.src=element.src;detailImage.alt=element.alt;
    detail.hidden=false;resetDetailZoom();
    videos().forEach(video=>{video.dataset.autoPaused='true';video.pause();});
    const source=element.getBoundingClientRect(),target=detailImage.getBoundingClientRect();
    detailAnimation=detailImage.animate([
      {transform:`translate(${source.left+source.width/2-target.left-target.width/2}px,${source.top+source.height/2-target.top-target.height/2}px) scale(${source.width/target.width})`,opacity:.4},
      {transform:'translate(0,0) scale(1)',opacity:1}
    ],{duration:reduceMotion.matches?0:380,easing:'cubic-bezier(.22,1,.36,1)'});
    document.getElementById('viewer-detail-close').focus();
  };
  const closeDetail = async () => {
    detailAnimation?.cancel();
    detailAnimation=detail.animate([{opacity:1},{opacity:0}],{duration:reduceMotion.matches?0:180,easing:'ease-out'});
    try { await detailAnimation.finished; } catch { return; }
    detail.hidden=true;resetDetailZoom();resumeAt=0;
    if(detailSource?.isConnected) detailSource.focus({preventScroll:true});else carousel.focus();
  };
  document.getElementById('viewer-detail-close').addEventListener('click',closeDetail);
  const open = key => {
    const project=meta[key];
    if(!project) return;
    returnFocus=document.activeElement;
    document.getElementById('viewer-title').textContent=key+'.gallery';
    modal.querySelector('.viewer-window').style.setProperty('--accent',project.accent);
    modal.querySelector('.viewer-window').style.setProperty('--surface',project.surface);
    const repo=document.getElementById('viewer-repo'),site=document.getElementById('viewer-site');
    repo.href=project.repo;
    site.style.display=project.site?'':'none';
    if(project.site) site.href=project.site;
    track.replaceChildren();
    const media=galleries[key]??[];
    for(let copy=0;copy<3;copy++) media.forEach((src,index)=>{
      const figure=document.createElement('figure');
      figure.className='viewer-slide';
      const video=/\.mp4(?:\?|$)/i.test(src);
      const element=document.createElement(video?'video':'img');
      element.src=src;
      element.draggable=false;
      if(video) {
        element.controls=true; element.muted=true; element.loop=true; element.playsInline=true; element.preload='metadata';
        element.addEventListener('pointerdown',()=>{resumeAt=performance.now()+12000;});
        element.addEventListener('play',()=>{delete element.dataset.userPaused;});
        element.addEventListener('pause',()=>{
          if(element.dataset.autoPaused) delete element.dataset.autoPaused;
          else element.dataset.userPaused='true';
        });
      } else {
        element.alt=project.title+' — '+(index+1);
        element.loading=copy===1?'eager':'lazy';
        element.tabIndex=copy===1?0:-1;
        const enlarge=()=>openDetail(element);
        element.addEventListener('click',()=>{if(travel<8)enlarge();});
        element.addEventListener('keydown',event=>{if(event.key==='Enter'){event.preventDefault();enlarge();}});
      }
      const caption=document.createElement('figcaption');
      caption.textContent=String(index+1).padStart(2,'0')+' / '+String(media.length).padStart(2,'0')+(video?' · VIDEO':'');
      figure.append(element,caption);track.append(figure);
    });
    covers.forEach(video=>video.pause());
    document.body.style.paddingRight=(innerWidth-document.documentElement.clientWidth)+'px';
    document.body.classList.add('overflow-hidden');
    modal.hidden=false;detail.hidden=true;position=0;cycle=0;dragging=false;travel=0;paused=reduceMotion.matches;updateMotion();
    measure();lastTime=0;resumeAt=performance.now()+1000;
    cancelAnimationFrame(frame);frame=requestAnimationFrame(animate);
    modal.querySelector('button[data-close]').focus();
  };
  const close = () => {
    modal.hidden=true;cancelAnimationFrame(frame);videos().forEach(video=>video.pause());
    document.body.classList.remove('overflow-hidden');document.body.style.paddingRight='';
    returnFocus?.focus();
    covers.forEach(video=>{const r=video.getBoundingClientRect();if(r.bottom>0&&r.top<innerHeight)video.play().catch(()=>{});});
  };
  modal.querySelectorAll('[data-close]').forEach(button=>button.addEventListener('click',close));
  document.querySelectorAll('[data-open-gallery]').forEach(card=>{
    card.addEventListener('click',()=>open(card.dataset.openGallery));
    card.addEventListener('keydown',event=>{if(event.target===card&&['Enter',' '].includes(event.key)){event.preventDefault();open(card.dataset.openGallery);}});
  });
  carousel.addEventListener('pointerdown',event=>{
    if(event.target.tagName==='VIDEO'||event.button!==0)return;
    dragging=true;travel=0;dragX=event.clientX;carousel.classList.add('dragging');
  });
  window.addEventListener('pointermove',event=>{
    if(!dragging)return;
    const delta=event.clientX-dragX;travel+=Math.abs(delta);position-=delta;dragX=event.clientX;render();
    if(travel>8&&!carousel.hasPointerCapture(event.pointerId))carousel.setPointerCapture(event.pointerId);
  });
  const endDrag=()=>{if(!dragging)return;dragging=false;carousel.classList.remove('dragging');resumeAt=0;};
  window.addEventListener('pointerup',endDrag);window.addEventListener('pointercancel',endDrag);
  carousel.addEventListener('wheel',event=>{if(Math.abs(event.deltaX)>Math.abs(event.deltaY)){event.preventDefault();position+=event.deltaX;render();resumeAt=0;}},{passive:false});
  motion.addEventListener('click',()=>{paused=!paused;updateMotion();});
  new ResizeObserver(()=>{if(!modal.hidden)measure();}).observe(carousel);
  document.addEventListener('keydown',event=>{
    if(modal.hidden)return;
    if(event.key==='Escape'){if(!detail.hidden)closeDetail();else close();}
    if(event.target===carousel&&['ArrowLeft','ArrowRight'].includes(event.key)){event.preventDefault();position+=event.key==='ArrowRight'?160:-160;render();resumeAt=performance.now()+2200;}
    if(event.key==='Tab'){
      const scope=detail.hidden?modal:detail;
      const controls=[...scope.querySelectorAll('button,a[href],[tabindex="0"],video[controls]')].filter(el=>el.getClientRects().length);
      const first=controls[0],last=controls.at(-1);
      if(event.shiftKey&&document.activeElement===first){event.preventDefault();last.focus();}
      else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first.focus();}
    }
  });
  const coverObserver=new IntersectionObserver(entries=>entries.forEach(({target,isIntersecting})=>{
    if(isIntersecting&&modal.hidden)target.play().catch(()=>{});else target.pause();
  }),{threshold:.2});
  covers.forEach(video=>coverObserver.observe(video));
</script>
